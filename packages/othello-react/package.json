{
  "name": "othello",
  "version": "0.2.0",
  "homepage": "https://cozygarage.github.io/Othello/",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "othello-engine": "workspace:*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "5.0.2",
    "@vitest/ui": "5.0.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "~8.3.2",
    "vitest": "5.0.2"
  }
}
